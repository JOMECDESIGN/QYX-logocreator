# ----------------------------------------------------------------------------
# Image provider for the AI showcase path (scripts/generate_showcase.py)
# The logo itself is hand-authored SVG and needs NONE of this.
# ----------------------------------------------------------------------------

# Which backend to use: gemini | together | openai-compatible
IMAGE_PROVIDER=gemini

# Model id (override per provider). Examples:
#   gemini            -> gemini-2.5-flash-image-preview (or your account's image model)
#   together          -> black-forest-labs/FLUX.1.1-pro
#   openai-compatible -> the image model id your endpoint exposes
IMAGE_MODEL=gemini-2.5-flash-image-preview

# --- gemini ---
GEMINI_API_KEY=
# Optional custom endpoint (proxy/gateway). Leave blank for default.
GEMINI_BASE_URL=

# --- together ---
TOGETHER_API_KEY=

# --- openai-compatible (Jimeng / Tongyi Wanxiang / self-hosted, etc.) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
